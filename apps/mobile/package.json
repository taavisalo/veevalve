{
  "name": "@veevalve/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "dev": "expo start --clear",
    "dev:client": "expo start --clear --dev-client",
    "dev:docker": "expo start --clear --host lan --port 8081",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "eas:build:dev:android": "eas build --profile development --platform android",
    "eas:build:dev:ios": "eas build --profile development --platform ios",
    "lint": "eslint \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "format": "prettier --check \"**/*.{ts,tsx,json}\"",
    "clean": "rm -rf .expo dist"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@veevalve/core": "workspace:*",
    "@veevalve/ui": "workspace:*",
    "expo": "~56.0.12",
    "expo-constants": "~56.0.18",
    "expo-dev-client": "~56.0.20",
    "expo-status-bar": "~56.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/react": "~19.2.17",
    "babel-preset-expo": "~56.0.15",
    "vitest": "^4.1.9"
  }
}

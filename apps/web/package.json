{
  "name": "@veevalve/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:docker": "next dev --turbopack --hostname 0.0.0.0 --port 3000",
    "build": "next build",
    "start": "next start",
    "lint": "eslint \"app/**/*.{ts,tsx}\" \"components/**/*.{ts,tsx}\" \"lib/**/*.{ts,tsx}\" \"test/**/*.{ts,tsx}\" \"next.config.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --check \"**/*.{ts,tsx,css,json}\"",
    "clean": "rm -rf .next"
  },
  "dependencies": {
    "@veevalve/core": "workspace:*",
    "@veevalve/ui": "workspace:*",
    "next": "^16.2.9",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.1",
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.17",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.1",
    "vitest": "^4.1.9"
  }
}
